{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "shopwise": { "source": { "source": "github", "repo": "MuriloSergioDev/shopwise-platform" } }
  },
  "enabledPlugins": { "shopwise@shopwise": true },
  "permissions": {
    "allow": [
      "Bash(docker run --rm -v * shopwise-php:base composer check:*)",
      "Bash(docker run --rm -v * shopwise-php:base vendor/bin/pest:*)",
      "Bash(docker run --rm -v * shopwise-php:base vendor/bin/phpstan:*)",
      "Bash(composer check:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
